{
  "name": "pnw-tribal-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Cascadia Tribal Hazard Dashboard: a static, multi-page hazard information site for Tribal Nations and First Nations across Cascadia (ATNI Climate).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/compile/all.mjs && node scripts/dev/serve.mjs",
    "serve": "node scripts/dev/serve.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run validate:data && npm run check",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.node.json",
    "pretest": "node scripts/compile/all.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/static/**/*.test.mjs\"",
    "test:cast": "node --test \"tests/cast/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/check/validate-data.mjs",
    "compile": "node scripts/compile/all.mjs",
    "snapshot": "node scripts/snapshot/run.mjs --out site/data/live",
    "assemble": "node scripts/assemble-site.mjs --out _site",
    "reference:fetch": "node scripts/reference/10-fetch-inputs.mjs",
    "reference:footprint": "node scripts/reference/20-footprint.mjs",
    "reference:zones": "node scripts/reference/30-zones.mjs",
    "reference:boundaries": "node scripts/reference/40-boundaries.mjs",
    "reference:registry": "node scripts/reference/50-registry.mjs",
    "reference:gauges": "node scripts/reference/60-gauges.mjs",
    "reference:joins": "node scripts/reference/70-joins.mjs",
    "reference:hazards": "node scripts/reference/80-hazards.mjs",
    "reference:validate": "node scripts/reference/90-validate.mjs",
    "reference:build": "npm run reference:fetch && npm run reference:footprint && npm run reference:zones && npm run reference:registry && npm run reference:boundaries && npm run reference:gauges && npm run reference:joins && npm run reference:hazards && npm run reference:validate",
    "reference:check": "node scripts/reference/90-validate.mjs --reproducibility",
    "check": "node scripts/check/all.mjs",
    "check:chrome": "node scripts/check/chrome.mjs",
    "check:preload": "node scripts/check/modulepreload.mjs",
    "check:modulepreload": "node scripts/check/modulepreload.mjs",
    "check:csp": "node scripts/check/csp.mjs --check",
    "check:vendor": "node scripts/check/vendor-integrity.mjs",
    "check:tokens": "node scripts/check/tokens.mjs",
    "check:contrast": "node scripts/check/contrast.mjs",
    "check:fonts": "node scripts/check/fonts-coverage.mjs",
    "check:copy": "node scripts/check/copy.mjs",
    "check:panels": "node scripts/check/panels.mjs",
    "check:no-fabrication": "node scripts/check/no-fabrication.mjs",
    "check:budgets": "node scripts/check/budgets.mjs",
    "check:live": "node scripts/check/validate-live.mjs site/data/live",
    "vendor": "node scripts/dev/vendor.mjs",
    "capture": "node scripts/dev/capture-fixture.mjs",
    "export:cast": "node scripts/export/to-cast.mjs",
    "export:ddm": "node scripts/export/to-ddm.mjs",
    "health:probe": "node scripts/health/probe-sources.mjs",
    "health:links": "node scripts/health/links.mjs",
    "actionlint": "node scripts/dev/actionlint.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@photostructure/tz-lookup": "11.7.0",
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.1",
    "@types/topojson-client": "3.1.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fast-xml-parser": "5.11.2",
    "fontkit": "2.0.4",
    "globals": "17.13.0",
    "js-yaml": "5.4.2",
    "mapshaper": "0.7.76",
    "maplibre-gl": "6.12.0",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2"
  }
}
