{
  "schema": "cthd.contrast-pairs/1",
  "description": "Every foreground and background pair the components use, resolved from tokens.css by scripts/check/contrast.mjs. kind: text (4.5:1), large (3.0:1, 19 px bold or 24 px regular and larger), nontext (3.0:1, shapes, keylines, rules, focus rings). expect: below marks a combination the design forbids; the check fails if it ever starts passing so the rule gets reviewed. Owner: lane L1.",
  "pairs": [
    { "fg": "--ink", "bg": "--ground", "kind": "text", "use": "body text on the page ground" },
    { "fg": "--ink", "bg": "--surface-raised", "kind": "text", "use": "panel and card text" },
    { "fg": "--ink", "bg": "--surface-overlay", "kind": "text", "use": "sheet, menu, and toast text" },
    { "fg": "--ink", "bg": "--surface-hover", "kind": "text", "use": "hovered rows and chips" },
    { "fg": "--ink-heading", "bg": "--ground", "kind": "text", "use": "headings on the ground" },
    { "fg": "--ink-heading", "bg": "--surface-raised", "kind": "text", "use": "panel titles" },
    { "fg": "--ink-muted", "bg": "--ground", "kind": "text", "use": "stamps and captions on the ground" },
    { "fg": "--ink-muted", "bg": "--surface-raised", "kind": "text", "use": "provenance footers and captions in panels" },
    { "fg": "--ink-muted", "bg": "--surface-overlay", "kind": "text", "use": "secondary text in sheets and the embed bar" },
    { "fg": "--ink-muted", "bg": "--surface-hover", "kind": "text", "use": "secondary text on hovered rows" },
    { "fg": "--link", "bg": "--ground", "kind": "text", "use": "links on the ground (Red on Dark)" },
    { "fg": "--link", "bg": "--surface-raised", "kind": "text", "use": "links in panels" },
    { "fg": "--link", "bg": "--surface-overlay", "kind": "text", "use": "links in sheets and the embed bar" },
    { "fg": "--red-on-dark", "bg": "--ground", "kind": "text", "use": "eyebrows" },
    { "fg": "--atni-red", "bg": "--surface-raised", "kind": "large", "use": "ATNI Red display accents at large sizes only" },
    { "fg": "--atni-red", "bg": "--surface-raised", "kind": "text", "expect": "below", "use": "small ATNI Red text is forbidden; small red text uses Red on Dark" },
    { "fg": "--atni-red", "bg": "--ground", "kind": "nontext", "use": "the 5 px header rule and the wordmark" },
    { "fg": "--color-surface", "bg": "--atni-red", "kind": "large", "use": "primary button label, League Spartan 600 at 19 px or larger" },
    { "fg": "--color-surface", "bg": "--atni-red", "kind": "text", "expect": "below", "use": "small white text on ATNI Red is forbidden" },
    { "fg": "--ground", "bg": "--ink", "kind": "text", "use": "solid designation badge (Emergency, Warning) and secondary button" },

    { "fg": "--band-extreme-ink", "bg": "--band-extreme-bg", "kind": "text", "use": "Extreme band chip" },
    { "fg": "--band-severe-ink", "bg": "--band-severe-bg", "kind": "text", "use": "Severe band chip with the dark ink correction" },
    { "fg": "#FFFFFF", "bg": "--band-severe-bg", "kind": "text", "expect": "below", "use": "white on Severe is forbidden (Q9)" },
    { "fg": "--band-moderate-ink", "bg": "--band-moderate-bg", "kind": "text", "use": "Moderate band chip" },
    { "fg": "--band-minor-ink", "bg": "--band-minor-bg", "kind": "text", "use": "Minor band chip" },
    { "fg": "--band-unstated-ink", "bg": "--band-unstated-bg", "kind": "text", "use": "Unstated band chip" },
    { "fg": "--band-extreme-keyline", "bg": "--surface-raised", "kind": "nontext", "use": "Extreme chip and fill keyline" },
    { "fg": "--band-extreme-bg", "bg": "--surface-raised", "kind": "nontext", "expect": "below", "use": "Extreme without its keyline is invisible on raised surfaces" },
    { "fg": "--band-severe-bg", "bg": "--surface-raised", "kind": "nontext", "use": "Severe band rule on cards and the banner" },
    { "fg": "--band-moderate-bg", "bg": "--surface-raised", "kind": "nontext", "use": "Moderate band rule" },
    { "fg": "--band-minor-bg", "bg": "--surface-raised", "kind": "nontext", "use": "Minor band rule" },
    { "fg": "--band-unstated-bg", "bg": "--surface-raised", "kind": "nontext", "use": "Unstated band rule" },

    { "fg": "--status-live", "bg": "--surface-raised", "kind": "nontext", "use": "Live filled circle" },
    { "fg": "--status-cached", "bg": "--surface-raised", "kind": "nontext", "use": "Cached circle with inner dot" },
    { "fg": "--status-stale", "bg": "--surface-raised", "kind": "nontext", "use": "Stale half-filled circle" },
    { "fg": "--status-degraded", "bg": "--surface-raised", "kind": "nontext", "use": "Degraded outlined triangle" },
    { "fg": "--status-unavailable", "bg": "--surface-raised", "kind": "nontext", "use": "Unavailable hollow circle with slash" },
    { "fg": "--status-live", "bg": "--ground", "kind": "nontext", "use": "Live shape on the ground" },
    { "fg": "--status-cached", "bg": "--ground", "kind": "nontext", "use": "Cached shape on the ground" },
    { "fg": "--status-stale", "bg": "--ground", "kind": "nontext", "use": "Stale shape on the ground" },
    { "fg": "--status-degraded", "bg": "--ground", "kind": "nontext", "use": "Degraded shape on the ground" },
    { "fg": "--status-unavailable", "bg": "--ground", "kind": "nontext", "use": "Unavailable shape on the ground" },
    { "fg": "--status-degraded", "bg": "--surface-overlay", "kind": "nontext", "use": "Degraded shape in the embed bar and sheets" },

    { "fg": "--tribal-magenta", "bg": "--ground", "kind": "nontext", "use": "boundary strokes and the sovereignty rule (lines only, never text)" },
    { "fg": "--tribal-magenta", "bg": "--surface-raised", "kind": "nontext", "use": "sovereignty callout rule on a raised surface" },
    { "fg": "--tribal-magenta", "bg": "--surface-raised", "kind": "text", "expect": "below", "use": "magenta text is forbidden; labels beside magenta marks use body ink" },
    { "fg": "--rule-strong", "bg": "--ground", "kind": "nontext", "use": "control outlines (filter chips, inputs, secondary outline buttons)" },
    { "fg": "--rule-strong", "bg": "--surface-raised", "kind": "nontext", "use": "control outlines inside panels" },
    { "fg": "--ink", "bg": "--surface-raised", "kind": "nontext", "use": "Watch outline badge and Advisory bar" },
    { "fg": "--focus-inner", "bg": "--ground", "kind": "nontext", "use": "focus ring inner outline" },
    { "fg": "--focus-inner", "bg": "--surface-raised", "kind": "nontext", "use": "focus ring inner outline in panels" },
    { "fg": "--focus-inner", "bg": "--focus-outer", "kind": "nontext", "use": "focus ring against its own outer ring on any backdrop" },

    { "fg": "--ink", "bg": "--ground", "kind": "text", "theme": "light", "use": "print and light layer body text" },
    { "fg": "--ink", "bg": "--surface-raised", "kind": "text", "theme": "light", "use": "light layer panel text" },
    { "fg": "--ink-heading", "bg": "--surface-raised", "kind": "text", "theme": "light", "use": "light layer headings" },
    { "fg": "--ink-muted", "bg": "--surface-raised", "kind": "text", "theme": "light", "use": "light layer stamps" },
    { "fg": "--ink-muted", "bg": "--ground", "kind": "text", "theme": "light", "use": "light layer stamps on the tint" },
    { "fg": "--link", "bg": "--surface-raised", "kind": "text", "theme": "light", "use": "Red Alt links on white" },
    { "fg": "--link", "bg": "--ground", "kind": "text", "theme": "light", "use": "Red Alt links on the tint" },
    { "fg": "--status-live", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "Live shape in print" },
    { "fg": "--status-cached", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "Cached shape in print" },
    { "fg": "--status-stale", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "Stale shape in print" },
    { "fg": "--status-degraded", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "Degraded shape in print" },
    { "fg": "--status-unavailable", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "Unavailable shape in print" },
    { "fg": "--band-extreme-keyline", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "Extreme keyline in print" },
    { "fg": "--focus-inner", "bg": "--surface-raised", "kind": "nontext", "theme": "light", "use": "light layer focus ring" }
  ]
}
