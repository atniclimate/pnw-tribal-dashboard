    "impacts": [
      {
        "stage": 43,
        "statement": "The Rogue River at Grants Pass will have reached its record flood stage dating back to Jan 1, 1862."
      },
      {
        "stage": 40,
        "statement": "Expect water on the floor of the Grants Pass water pumping station."
      },
      {
        "stage": 36,
        "statement": "The river level is at the floor of the Highway 99 bridge in Grants Pass."
      },
      {
        "stage": 33.6,
        "statement": "Expect severe primary bank erosion from 6th street to the western city limits of Grants Pass."
      },
      {
        "stage": 30,
        "statement": "Widespread flooding of farms and residences on the lower banks of the Rogue River from Savage Rapids to the confluence of the Applegate River, including Grants Pass."
      },
      {
        "stage": 28,
        "statement": "Expect flooding of numerous homes in the town of Grants Pass."
      },
      {
        "stage": 27,
        "statement": "Expect flooding of homes along the Rogue River in the town of Grants Pass and flooding of homes and businesses along the Rogue River from Bloody Run Creek to Savage Rapids."
      },
      {
        "stage": 21,
        "statement": "Expect some slight lowland flooding downstream of the Highway 99 bridge along River Road."
      },
      {
        "stage": 20,
        "statement": "The Rogue River is at flood stage."
      }
    ]
