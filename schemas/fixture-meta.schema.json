{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atniclimate.github.io/pnw-tribal-dashboard/schemas/fixture-meta.schema.json",
  "title": "Fixture Metadata",
  "description": "tests/fixtures/upstream/<source>/<date>-<label>.meta.json, written by scripts/dev/capture-fixture.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceId",
    "label",
    "file",
    "url",
    "method",
    "requestHeaders",
    "capturedAt",
    "status",
    "contentType",
    "lastModified",
    "bytes",
    "sha256",
    "covers",
    "derivedFrom",
    "edits",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "cthd.fixture-meta/1"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/sourceId"
    },
    "label": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "file": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\.(json|xml|png)$"
    },
    "url": {
      "$ref": "common.schema.json#/$defs/httpsUrl"
    },
    "method": {
      "enum": ["GET", "HEAD"],
      "description": "HEAD for probe bundles that record Last-Modified and size without the body."
    },
    "requestHeaders": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capturedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "status": {
      "type": "integer",
      "minimum": 200,
      "maximum": 299
    },
    "contentType": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastModified": {
      "type": [
        "string",
        "null"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "covers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/kebabId"
      }
    },
    "derivedFrom": {
      "type": [
        "string",
        "null"
      ]
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
