{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atniclimate.github.io/pnw-tribal-dashboard/schemas/live-alerts.schema.json",
  "title": "Live Envelope: alerts.json",
  "description": "site/data/live/alerts.json: alert index, no text or geometry (blueprint 5.10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "sourceIds",
    "generatedAt",
    "observedAt",
    "asOf",
    "asOfBasis",
    "completeness",
    "carriedForward",
    "failure",
    "perSource",
    "diagnostics",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "cthd.live.alerts/1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceId"
      },
      "minItems": 1
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "asOf": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/isoDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "asOfBasis": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/asOfBasis"
        },
        {
          "type": "null"
        }
      ]
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "rejected"
      ]
    },
    "carriedForward": {
      "type": "boolean"
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "at"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/isoDateTime"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "perSource": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/sourceId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "count",
          "asOf"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "asOf": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/isoDateTime"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "dashboard-alert.schema.json#/$defs/index"
      }
    }
  }
}
