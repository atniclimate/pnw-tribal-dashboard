{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atniclimate.github.io/pnw-tribal-dashboard/schemas/imagery-products.schema.json",
  "title": "Imagery Products",
  "description": "data/imagery/products.yaml (blueprint 5.9).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "sourceId",
      "url",
      "kind",
      "typicalBytes",
      "loadPolicy"
    ],
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/kebabId"
      },
      "sourceId": {
        "$ref": "common.schema.json#/$defs/sourceId"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "$ref": "common.schema.json#/$defs/httpsUrl"
      },
      "still": {
        "$ref": "common.schema.json#/$defs/httpsUrl"
      },
      "kind": {
        "enum": [
          "still",
          "loop-gif",
          "video"
        ]
      },
      "typicalBytes": {
        "type": "integer",
        "minimum": 1
      },
      "loadPolicy": {
        "enum": [
          "auto",
          "tap",
          "link"
        ]
      },
      "larger": {
        "$ref": "common.schema.json#/$defs/kebabId"
      },
      "animation": {
        "$ref": "common.schema.json#/$defs/kebabId"
      },
      "stamp": {
        "enum": [
          "last-modified",
          "cycle",
          "none"
        ]
      }
    }
  }
}
