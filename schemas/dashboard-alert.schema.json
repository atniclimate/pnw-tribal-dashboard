      "additionalProperties": false,
      "required": [
        "alertId",
        "eventId",
        "sourceId",
        "sent",
        "messageType",
        "references",
        "lifecycleState",
        "event",
        "originalDesignation",
        "band",
        "posture",
        "confidence",
        "effective",
        "expires",
        "translationAuthority",
        "provenance",
        "agency",
        "designation",
        "categories",
        "zones",
        "jurisdictions",
        "marine",
        "nationIds",
        "senderName",
