{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atniclimate.github.io/pnw-tribal-dashboard/schemas/live-manifest.schema.json",
  "title": "Live Snapshot Manifest",
  "description": "site/data/live/manifest.json, written last (blueprint 5.10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "buildSha",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "cthd.live.manifest/1"
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "buildSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "observedAt",
          "carriedForward"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^data/live/[a-z0-9-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "observedAt": {
            "$ref": "common.schema.json#/$defs/isoDateTime"
          },
          "carriedForward": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
