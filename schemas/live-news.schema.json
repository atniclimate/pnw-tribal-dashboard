{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atniclimate.github.io/pnw-tribal-dashboard/schemas/live-news.schema.json",
  "title": "Live Envelope: news.json",
  "description": "site/data/live/news.json: plain-text items from scheduled feed fetches (blueprint 5.8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "sourceIds",
    "generatedAt",
    "observedAt",
    "asOf",
    "asOfBasis",
    "completeness",
    "carriedForward",
    "failure",
    "perSource",
    "diagnostics",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "cthd.live.news/1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceId"
      },
      "minItems": 1
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "asOf": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/isoDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "asOfBasis": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/asOfBasis"
        },
        {
          "type": "null"
        }
      ]
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "rejected"
      ]
    },
    "carriedForward": {
      "type": "boolean"
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "at"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/isoDateTime"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "perSource": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/sourceId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "count",
          "asOf"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "asOf": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/isoDateTime"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "title",
          "url",
          "published",
          "summary",
          "kind",
          "regions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "sourceId": {
            "$ref": "common.schema.json#/$defs/sourceId"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "$ref": "common.schema.json#/$defs/httpsUrl"
          },
          "published": {
            "$ref": "common.schema.json#/$defs/isoDateTime"
          },
          "summary": {
            "type": "string",
            "maxLength": 280
          },
          "kind": {
            "enum": [
              "official",
              "media",
              "video",
              "community"
            ]
          },
          "regions": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/jurisdiction"
            }
          }
        }
      }
    }
  }
}
