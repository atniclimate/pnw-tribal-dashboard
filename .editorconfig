root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{index.html,site/classic/index.html}]
# The May 2026 dashboard and its copies are kept byte for byte.
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
indent_size = unset

[tests/fixtures/**]
# Captured upstream responses are kept exactly as received.
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
